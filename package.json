{
  "name": "@mengtaoxin/evolving",
  "version": "0.13.0",
  "description": "Declarative ordered stages checklist and machine-stage runner driven by evolving.yml",
  "license": "MIT",
  "type": "module",
  "bin": {
    "evolving": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "templates"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mengtaoxin/evolving.git"
  }
}
