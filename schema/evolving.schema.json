{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mengtaoxin/evolving/schema/evolving.schema.json",
  "title": "evolving.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "after_edit", "stages"],
  "properties": {
    "version": { "const": 2 },
    "after_edit": {
      "type": "array",
      "const": ["prepare", "verify"],
      "description": "Protocol after code edits; surfaced by evolving explain / contract. Downstream docs must not restate this."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/guidanceStage" },
          { "$ref": "#/$defs/prepareStage" },
          { "$ref": "#/$defs/verifyStage" },
          { "$ref": "#/$defs/runStage" }
        ]
      }
    }
  },
  "$defs": {
    "gateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "name": { "type": "string", "minLength": 1 },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "showOutputOnSuccess": { "type": "boolean" },
        "fix": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Write-side companion printed on check/verify failure; not executed by those commands."
        },
        "onMissing": {
          "const": "warn",
          "description": "If the executable is not on PATH (spawn ENOENT), warn and continue; other failures still fail the gate."
        }
      }
    },
    "guidanceStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "guidance" },
        "summary": { "type": "string" },
        "refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skip_when": {
          "type": "string",
          "minLength": 1,
          "description": "Agent-evaluated skip hint; the CLI never evaluates it. Recommended tokens: entry_file_known, docs_only, no_behavior_change, already_verified. Free text is allowed."
        }
      }
    },
    "prepareStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "steps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "prepare" },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateCommand" },
          "description": "Write-allowed steps (format / lint:fix). Run via evolving prepare; never by check/verify."
        }
      }
    },
    "verifyStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "check", "detect", "suites"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "verify" },
        "check": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateCommand" },
          "description": "Static read-only gates; also the first phase of evolving verify (check ⊂ verify)."
        },
        "detect": { "const": "git" },
        "suites": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/verifySuite" }
        },
        "always": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateCommand" }
        }
      }
    },
    "runStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "run" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },
    "verifySuite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paths"],
      "anyOf": [
        { "required": ["command"] },
        { "required": ["also"] }
      ],
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "also": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "name": { "type": "string", "minLength": 1 }
      }
    }
  }
}
