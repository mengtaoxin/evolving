{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mengtaoxin/evolving/schema/evolving.schema.json",
  "title": "evolving.yml",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "after_edit", "stages"],
  "properties": {
    "version": { "const": 2 },
    "after_edit": {
      "type": "array",
      "const": ["prepare", "verify"],
      "description": "Protocol after code edits; surfaced by evolving explain / contract. Downstream docs must not restate this."
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/guidanceStage" },
          { "$ref": "#/$defs/prepareStage" },
          { "$ref": "#/$defs/verifyStage" },
          { "$ref": "#/$defs/runStage" }
        ]
      }
    }
  },
  "$defs": {
    "gateCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "name": { "type": "string", "minLength": 1 },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "showOutputOnSuccess": { "type": "boolean" },
        "onMissing": {
          "const": "warn",
          "description": "If the executable is not on PATH (spawn ENOENT), warn and continue; other failures still fail the gate."
        }
      }
    },
    "verifyCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Stable id for CLI selection and command:// refs. Defaults to name when omitted."
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Real argv, or only command://id refs that expand to other verify commands."
        },
        "run_in_file_change": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "Git path patterns; omit to always run this command on verify."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "showOutputOnSuccess": { "type": "boolean" },
        "onMissing": { "const": "warn" }
      }
    },
    "guidanceStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "guidance" },
        "summary": { "type": "string" },
        "refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "skip_when": {
          "type": "string",
          "minLength": 1,
          "description": "Agent-evaluated skip hint; the CLI never evaluates it. Recommended tokens: entry_file_known, docs_only, no_behavior_change, already_verified. Free text is allowed."
        }
      }
    },
    "prepareStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "commands"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "prepare" },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/gateCommand" },
          "description": "Write-allowed commands (format / lint:fix). Run via evolving prepare; never by verify."
        }
      }
    },
    "verifyStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "commands"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "verify" },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/verifyCommand" },
          "description": "Read-only commands in order. Omit run_in_file_change to always run; otherwise select via git paths. Composition via command://id."
        }
      }
    },
    "runStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "command"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "run" },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
